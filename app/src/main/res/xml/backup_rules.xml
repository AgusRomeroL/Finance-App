<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de la copia automática para Android 11 y anteriores. La app pide API 31
  como mínimo, así que este archivo no llega a aplicarse nunca; se mantiene
  alineado con data_extraction_rules.xml para que las dos no se contradigan.
-->
<full-backup-content>
    <include domain="database" path="budget.db" />
    <include domain="file" path="datastore/budget_settings.preferences_pb" />
    <exclude domain="database" path="budget.db-shm" />
    <exclude domain="database" path="budget.db-wal" />
</full-backup-content>
